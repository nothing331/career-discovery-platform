# Product-local settings. Paths resolve from data-engine/, regardless of current working directory.
ENGINE_DATA_DIR=data
ENGINE_REGISTRY=config/DE.json
ENGINE_USER_AGENT=CareerDiscoveryPOC/0.1
ENGINE_DELAY_SECONDS=3
ENGINE_MAX_DOCUMENTS=50
ENGINE_MAX_RETRIES=2
# Depth-1 same-host follow-up pages per programme (0 disables, max 12).
ENGINE_FOLLOWUP_LIMIT=6
ENGINE_RUN_BUDGET_USD=5
LLM_PROVIDER=openrouter
# Live model calls require both this key and an explicit --llm option.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# Maximum provider rates, USD per million tokens. Enforced in routing and reservations.
OPENROUTER_MAX_INPUT_PER_MILLION=0.20
OPENROUTER_MAX_OUTPUT_PER_MILLION=0.50
OPENROUTER_MAX_OUTPUT_TOKENS=2048
# For the one-programme pilot, select LLM_PROVIDER=groq and add your Groq key.
# Groq token-rate estimates are NOT billed dollars or provider-enforced price ceilings.
# Rates below are for GPT-OSS 20B; update both rates if changing the model/pricing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_INPUT_PER_MILLION=0.075
GROQ_OUTPUT_PER_MILLION=0.30
GROQ_MAX_OUTPUT_TOKENS=4096
# Rate limits (do not change outputs/caches). Groq free-tier defaults shown; 0 disables pacing.
# Groq Developer tier has much higher limits: raise these for faster runs.
GROQ_TPM_LIMIT=8000
GROQ_RPM_LIMIT=30
OPENROUTER_TPM_LIMIT=0
OPENROUTER_RPM_LIMIT=0
# HTTP 429 retries per request and the longest single wait (seconds).
LLM_RATE_LIMIT_RETRIES=4
LLM_RATE_LIMIT_MAX_WAIT=60
